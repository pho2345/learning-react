on:
  push:
    branches:
      - main
      - staging

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: appleboy/ssh-action@v1.0.0
        with:
          host: ${{ github.ref_name == 'staging' && secrets.EC2_HOST_STAGING || secrets.EC2_HOST_PROD }}
          username: ${{ secrets.EC2_USER }}
          key: ${{ secrets.EC2_SSH_KEY }}
          script: |
            if [ "${{ github.ref_name }}" = "staging" ]; then
              cd /var/www/myapp-staging
              git pull origin staging
              pnpm install
              pnpm build
              pm2 reload myapp-staging || pm2 start npm --name "myapp-staging" -- start
            else
              cd /var/www/myapp
              git pull origin main
              pm2 reload myapp || pm2 start npm --name "myapp" -- start
            fi
